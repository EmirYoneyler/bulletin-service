# Fon Bülteni · ortam değişkenleri
# Kullanım: cp .env.example .env  ve değerleri düzenleyin. .env dosyası git'e girmez.
# Buradaki değerlerin hepsi SAHTEDİR. Gerçek şifre ve anahtarları yalnızca .env dosyasına yazın.

# --- Spring profili ---
# Yerel geliştirmede "dev": sabit, herkese açık bir geliştirme JWT anahtarı kullanır.
# Üretimde boş bırakın.
SPRING_PROFILES_ACTIVE=dev

# --- Veritabanı (PostgreSQL) ---
# JDBC adresi. Uygulamayı host'ta (IDE'de) çalıştırıp compose'daki Postgres'e bağlanmak içindir.
# docker compose içindeki uygulama bu değeri yok sayar ve postgres:5432 kullanır.
# Uygulamadaki varsayılan: jdbc:postgresql://localhost:5432/fonbulteni
DB_URL=jdbc:postgresql://localhost:5433/fonbulteni
# Veritabanı kullanıcısı. Varsayılan: postgres
DB_USER=postgres
# Veritabanı şifresi. Varsayılanı yok, compose'daki Postgres de bu şifreyle kurulur.
DB_PASSWORD=degistir-beni
# compose'daki Postgres'in host'taki portu. Varsayılan: 5433 (yerel kurulu bir PostgreSQL ile çakışmasın diye)
POSTGRES_HOST_PORT=5433

# --- JWT ---
# auth-service ile AYNI olmalı. En az 32 bayt. Üretmek için: openssl rand -base64 48
# Boşsa uygulama başlamaz ("dev" profili hariç). Değişkeni boş bırakmak yerine
# kullanmayacaksanız satırı tamamen silin: boş değer de "ayarlanmış" sayılır.
JWT_SECRET=sahte-yerel-anahtar-en-az-32-bayt-olmali-degistirin
# Token ömrü, milisaniye. Varsayılan: 86400000 (24 saat)
JWT_EXPIRATION_MS=86400000

# --- TCMB EVDS (TÜFE, USD/TRY, altın, mevduat faizi) ---
# Ücretsiz kişisel anahtar: https://evds3.tcmb.gov.tr → üye ol → Benim Sayfam → Profilim → "API Key Kopyala".
# Boşsa EVDS istemcisi kapalı kalır; uygulama çalışır ama bültenin kıyas ve reel getiri bölümleri atlanır.
EVDS_API_KEY=

# --- Bülten yazarı (LLM) ---
# template (varsayılan): model ve anahtar gerekmez, metni şablonlar yazar.
# ollama: yerel model, önce: docker compose --profile llm up -d && docker compose exec ollama ollama pull qwen2.5:7b-instruct
#         Adres ve model boşsa varsayılan kullanılır (http://ollama:11434/v1, qwen2.5:7b-instruct), zaman aşımı 120 sn.
# openai-compatible: OpenAI biçimini konuşan ücretsiz katmanlı bir uzak sağlayıcı. Adres ve model zorunlu.
#   Google Gemini:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   Groq:           LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL için sağlayıcının güncel model listesine bakın (ör. Gemini'nin "flash" ya da Groq'un "llama" modelleri).
#   Not: ücretsiz katmanlarda gönderilen veri eğitimde kullanılabilir. Bültene giden metin yalnızca kamuya açık
#   fon verisinin yer tutucularını içerir; e-posta, ad ve portföy adetleri gönderilmez.
LLM_PROVIDER=template
LLM_BASE_URL=
LLM_MODEL=
# Ollama için boş kalabilir. Uzak sağlayıcıda sağlayıcının verdiği anahtar.
LLM_API_KEY=
# İsteğe bağlı, ör. 45s. Boşsa Ollama 120s, diğerleri 30s.
LLM_TIMEOUT=
